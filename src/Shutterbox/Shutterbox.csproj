<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Shutterbox</RootNamespace>
    <AssemblyName>Shutterbox</AssemblyName>
    <ApplicationIcon>Assets\shutterbox.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Version info shown in About, file properties and the installer -->
    <Version>0.6.0</Version>
    <InformationalVersion>0.3.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>Shutterbox</Product>
    <Company>Bytehawk Studio</Company>
    <Description>Shutterbox - photo and video organizer for Windows</Description>
    <Copyright>© 2026 Bytehawk Studio</Copyright>

    <!-- Self-contained single-file exe: users do not need .NET installed -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Allows `dotnet build` on non-Windows machines for compile checks -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Hello for the Locked album keeps its key protected for your Windows account (DPAPI) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- People and "search by what's in the photo" run these models on the PC -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown in Settings > About > What's new -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <!-- The same models and words as the Android app (see mobile/assets/models/NOTICE.md) -->
    <EmbeddedResource Include="..\..\mobile\assets\models\face_detection_yunet_2023mar.onnx" LogicalName="face_detection_yunet_2023mar.onnx" />
    <EmbeddedResource Include="..\..\mobile\assets\models\face_recognition_sface_2021dec_int8.onnx" LogicalName="face_recognition_sface_2021dec_int8.onnx" />
    <EmbeddedResource Include="..\..\mobile\assets\models\image_classification_mobilenetv2_2022apr_int8.onnx" LogicalName="image_classification_mobilenetv2_2022apr_int8.onnx" />
    <EmbeddedResource Include="..\..\mobile\assets\models\vision_words.txt" LogicalName="vision_words.txt" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\shutterbox.ico" />
    <Resource Include="Assets\shutterbox-256.png" />
  </ItemGroup>

</Project>
