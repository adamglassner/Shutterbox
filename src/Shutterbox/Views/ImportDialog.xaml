<Window x:Class="Shutterbox.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import photos" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Border x:Name="Frame" Background="{DynamicResource DialogBg}" Padding="26,22,26,22">
    <StackPanel x:Name="Root" Width="600">
        <TextBlock Text="Import photos" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Copy pictures from a camera card, phone or folder into your library. Shutterbox skips the ones you already have."
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <TextBlock Text="FROM" Style="{StaticResource FieldName}" Margin="0,20,0,8"/>
        <WrapPanel x:Name="CardsPanel" Margin="0,0,0,4"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Content="Choose folder…" Click="BrowseSource_Click"/>
            <TextBox x:Name="SourceBox" Style="{StaticResource HintBox}" Tag="A camera card, phone (DCIM folder) or any folder" IsReadOnly="True" Height="38"/>
        </DockPanel>

        <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="SummaryTitle" FontWeight="SemiBold" FontSize="15" Text="Choose where to import from"/>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Plug in a camera card or phone, or choose a folder."/>
                <ProgressBar x:Name="AnalyzeProgress" Style="{StaticResource ProgressThin}" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Text="HOW" Style="{StaticResource FieldName}" Margin="0,20,0,8"/>
        <RadioButton x:Name="CopyMode" Content="Copy them into my library folder" IsChecked="True" GroupName="mode" Checked="Mode_Changed"/>
        <StackPanel x:Name="CopyOptions" Margin="28,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="8,0,0,0" Content="Change…" Click="BrowseDest_Click"/>
                <TextBox x:Name="DestBox" Style="{StaticResource HintBox}" IsReadOnly="True" Height="38"/>
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Folders" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondary}"/>
                <ComboBox x:Name="LayoutBox" Width="300" HorizontalAlignment="Left" SelectionChanged="LayoutBox_SelectionChanged">
                    <ComboBoxItem Content="Year, then day (2026\2026-10-14)"/>
                    <ComboBoxItem Content="Year, then month (2026\2026-10)"/>
                    <ComboBoxItem Content="All in one folder"/>
                </ComboBox>
            </DockPanel>
            <TextBlock x:Name="ExampleText" FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            <CheckBox x:Name="SkipDupBox" Content="Skip photos already in my library" IsChecked="True" Margin="0,12,0,0" Click="Options_Changed"/>
            <CheckBox x:Name="DeleteBox" Content="Delete the originals after copying (to clear a camera card)" Margin="0,8,0,0"/>
        </StackPanel>
        <RadioButton x:Name="AddMode" Content="Leave them where they are and add the folder to my library" GroupName="mode" Margin="0,14,0,0" Checked="Mode_Changed"/>

        <StackPanel x:Name="ProgressArea" Margin="0,18,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="ImportProgress" Style="{StaticResource ProgressThin}" Maximum="1"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ImportBtn" Content="Import" Style="{StaticResource AccentButton}" IsEnabled="False" IsDefault="True" Click="Import_Click" MinWidth="120"/>
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
