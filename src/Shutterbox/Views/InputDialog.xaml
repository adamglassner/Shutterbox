<Window x:Class="Shutterbox.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" MinWidth="400">
    <StackPanel Margin="24,20,24,20" Width="380">
        <TextBlock x:Name="HeadingText" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="HintText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="LabelText" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"/>
        <TextBox x:Name="Input" Style="{StaticResource HintBox}" MaxLength="120" KeyDown="Input_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="OkBtn" Content="OK" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
